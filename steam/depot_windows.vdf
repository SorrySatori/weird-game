"DepotBuild"
{
	"DepotID"     "5564541"   // the DEMO app's depot (SteamPipe → Depots, OS: Windows); not 4118601 (full game)
	"ContentRoot" "../out/demo/weird-game-win32-x64/"

	"FileMapping"
	{
		"LocalPath" "*"
		"DepotPath" "."
		"recursive" "1"
	}

	"FileExclusion" "*.pdb"
	"FileExclusion" "*.log"
}
